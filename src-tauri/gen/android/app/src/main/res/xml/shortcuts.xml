<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: quick capture straight into a list. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="task" android:enabled="true" android:icon="@drawable/ic_shortcut_task"
        android:shortcutShortLabel="@string/shortcut_task">
        <intent android:action="com.matt.kaizen.CAPTURE" android:targetPackage="com.matt.kaizen"
            android:targetClass="com.matt.kaizen.MainActivity">
            <extra android:name="kind" android:value="task" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="idea" android:enabled="true" android:icon="@drawable/ic_shortcut_idea"
        android:shortcutShortLabel="@string/shortcut_idea">
        <intent android:action="com.matt.kaizen.CAPTURE" android:targetPackage="com.matt.kaizen"
            android:targetClass="com.matt.kaizen.MainActivity">
            <extra android:name="kind" android:value="idea" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="focus" android:enabled="true" android:icon="@drawable/ic_shortcut_focus"
        android:shortcutShortLabel="@string/shortcut_focus">
        <intent android:action="com.matt.kaizen.CAPTURE" android:targetPackage="com.matt.kaizen"
            android:targetClass="com.matt.kaizen.MainActivity">
            <extra android:name="kind" android:value="focus" />
        </intent>
    </shortcut>
</shortcuts>
