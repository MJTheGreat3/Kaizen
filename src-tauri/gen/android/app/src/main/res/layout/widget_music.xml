<?xml version="1.0" encoding="utf-8"?>
<!-- The face, record and clock are square images of the same size, so they line up at any widget size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/music_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/music_disc"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <AnalogClock
        android:id="@+id/music_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dial="@drawable/transparent"
        android:hand_hour="@drawable/transparent"
        android:hand_minute="@drawable/transparent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/music_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:alpha="0.9"
        android:contentDescription="Play"
        android:src="@drawable/ic_widget_play" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/music_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:contentDescription="Back 15 seconds" />

        <FrameLayout
            android:id="@+id/music_center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:contentDescription="Play or pause" />

        <FrameLayout
            android:id="@+id/music_forward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:contentDescription="Forward 15 seconds" />
    </LinearLayout>

    <ImageView
        android:id="@+id/music_open"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_music_open"
        android:contentDescription="Open Music in Kaizen"
        android:padding="7dp"
        android:src="@drawable/ic_widget_open" />

    <ImageView
        android:id="@+id/music_prev"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/widget_corner"
        android:contentDescription="Previous song"
        android:padding="6dp"
        android:src="@drawable/ic_widget_prev" />

    <ImageView
        android:id="@+id/music_next"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/widget_corner"
        android:contentDescription="Next song"
        android:padding="6dp"
        android:src="@drawable/ic_widget_next" />
</FrameLayout>
