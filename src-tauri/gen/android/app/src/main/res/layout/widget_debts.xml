<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_debts"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/debts_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_tile_debts"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_widget_rupee" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/debts_net"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Debts"
                android:textColor="@color/widget_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/debts_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/debts_people"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView android:id="@+id/debts_p1" style="@style/WidgetDebtRow" />
        <TextView android:id="@+id/debts_p2" style="@style/WidgetDebtRow" />
        <TextView android:id="@+id/debts_p3" style="@style/WidgetDebtRow" />
    </LinearLayout>

    <!-- Looks like a text field; widgets cannot take typing, so it opens the entry box in Kaizen. -->
    <LinearLayout
        android:id="@+id/debts_add"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Rahul owes 250 for pizza…"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_tile_debts"
            android:contentDescription="Add an entry"
            android:padding="6dp"
            android:src="@drawable/ic_widget_plus_white" />
    </LinearLayout>
</LinearLayout>
