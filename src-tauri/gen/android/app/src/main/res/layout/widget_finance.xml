<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1: spent today and this month, and Expense / Income buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_finance"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/finance_head"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_tile_finance"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_widget_wallet" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/finance_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Money"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/finance_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/finance_expense"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_tile_spend"
        android:contentDescription="Add an expense"
        android:padding="9dp"
        android:src="@drawable/ic_widget_minus_white" />

    <ImageView
        android:id="@+id/finance_income"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_tile_finance"
        android:contentDescription="Add income"
        android:padding="9dp"
        android:src="@drawable/ic_widget_plus_white" />
</LinearLayout>
