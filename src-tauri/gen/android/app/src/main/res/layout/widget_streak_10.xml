<?xml version="1.0" encoding="utf-8"?>
<!-- The chosen streaks, moving on every 10 s; tapping a card opens its page in Kaizen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <ViewFlipper
        android:id="@+id/streak_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="10000"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out" />

    <TextView
        android:id="@+id/streak_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
